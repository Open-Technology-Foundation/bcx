#!/usr/bin/bash
# Bash completion for bcx and the `?` alias.
#
# Completes the documented short/long options and the `--` end-of-options
# marker when the current word starts with `-`; for any other prefix we
# yield no suggestions, since mathematical expressions are user-defined.

_bcx_completion() {
  local -- cur opts
  COMPREPLY=()
  cur=${COMP_WORDS[COMP_CWORD]}
  opts='-h --help -V --version -s --scale --'

  if [[ $cur == -* ]]; then
    mapfile -t COMPREPLY < <(compgen -W "$opts" -- "$cur")
  fi
  return 0
}

complete -F _bcx_completion bcx
# `?` is the documented alias (see show_help in bcx); register the same fn.
# Quote the literal '?' so shells with a single-char file in CWD do not
# glob-expand it before `complete` sees it.
complete -F _bcx_completion '?'
