#!/bin/bash
#shellcheck disable=SC2317,SC2329
# bcx - terminal calculator for floating point expressions
set -euo pipefail
shopt -s inherit_errexit

## INITIALIZATION ##

# Script metadata
declare -r VERSION='1.0.0' # 2025-10-20

# Global variables
declare -- BC errfile expression
declare -i err=0 is_terminal=0

# History configuration
declare -r HISTFILE="$HOME"/.bcx_history
declare -ri HISTSIZE=1000 HISTFILESIZE=2000

## FUNCTIONS ##

cleanup() {
  # EXIT/SIGINT/SIGTERM trap: persist REPL history (terminal mode only),
  # remove the temp error file, then exit with the original status.
  # `trap -` disarms before any blocking I/O so a second signal cannot re-enter.
  # `exit` (not `return`) is required to terminate on SIGTERM rather than resume.
  local -i exit_code=${1:-$?}
  trap - SIGINT SIGTERM EXIT
  ((is_terminal)) && history -w "$HISTFILE" 2>/dev/null ||:
  rm -f "${errfile:-}"
  exit "$exit_code"
}

setup_history() {
  # Enable bash history facility and load prior REPL entries from disk.
  set -o history
  history -r "$HISTFILE" 2>/dev/null || :
}

process_expression() {
  # Join all argv into a single expression and strip every space character.
  # Note: the x→* substitution is NOT done here — that's terminal-mode only,
  # applied by the caller after this function returns.
  local -- expr="$*"
  expr=${expr// /}
  printf '%s\n' "$expr"
}

evaluate_expression() {
  # Pipe expression to `bc --mathlib`; capture bc's stderr to $errfile so we
  # can detect parse/runtime errors (bc still exits 0 on syntax errors, hence
  # the file-size probe). Returns 22 (ERR_INVAL) if bc emitted any diagnostic,
  # else 0.
  local -- expr=$1
  local -i exit_code=0

  "$BC" --mathlib <<<"$expr" 2>"$errfile"

  if [[ -s "$errfile" ]]; then
    >&2 echo "bcx: ✗ Invalid expression ${expr@Q}"
    >&2 cat "$errfile"
    exit_code=22  # ERR_INVAL (BCS0602)
  fi

  return "$exit_code"
}

interactive_sigint_handler() {
  # Handle Ctrl-C during interactive REPL
  # EXIT trap handles cleanup; just exit with signal code
  >&2 echo
  exit 130
}

interactive_loop() {
  # REPL with readline editing (`read -e`) and persistent history.
  # Override SIGINT so Ctrl-C exits with code 130 instead of being silently
  # caught by the global cleanup trap; restored to cleanup on exit.
  trap 'interactive_sigint_handler' SIGINT

  local -- expr
  while :; do
    read -e -r -p '> ' expr || break  # Ctrl-D / EOF
    [[ -n $expr ]] || break            # blank line
    history -s "$expr"
    evaluate_expression "$expr" || :   # bc errors don't break the loop
  done

  trap 'cleanup $?' SIGINT
}

show_help() {
  cat <<'HELP'
bcx - terminal calculator for floating point expressions

This is a wrapper script for bc (see: man bc).

Because bc at the terminal sucks.

```shell
0:~/bcx:biksu@okusi$ bc --mathlib <<<"42*72/3.14%0.137"
.00000000000000000000043
0:~/bcx:biksu@okusi$ bcx 42x72 /3.14% 0.137
> 42*72/3.14%0.137
.00000000000000000000043
>
```

Usage: bcx [-h|--help] [-V|--version] [expression...]

  With expression:  evaluate and enter REPL (terminal) or print result (pipe)
  Without args:     enter interactive REPL (terminal) or show help + exit 2 (pipe)

Multiple args are joined and stripped of spaces before evaluation.

REPL controls:
  Ctrl-D or empty line  exit (code 0)
  Ctrl-C                exit (code 130)
  ↑/↓                   history navigation
  Ctrl-R                reverse history search

Examples:
  bcx 3.14*2
  bcx 23x42       # x → * when in terminal mode
  bcx "sqrt(2)"
  fp_result=$(bcx 42*69*72/3.14)

Setup alias in ~/.bashrc:
  alias ?='/usr/local/bin/bcx'

Then:
  ? 23*42         # ✓ no spaces around *
  ? 23 * 42       # ✗ Incorrect on command line!
  ? 23x42         # can use x for * on command line
  ? 23 x 42       # with spaces
HELP
}

## EXECUTION ##

# Simple Argument parsing
[[ ${1:-} == '-h' || ${1:-} == '--help' ]] && { show_help; exit 0; }
[[ ${1:-} == '-V' || ${1:-} == '--version' ]] && { echo "bcx $VERSION"; exit 0; }

# Locate bc command
BC=$(command -v bc) || { >&2 echo "bcx: ✗ 'bc' not found"; exit 18; }  # ERR_NODEP
declare -r BC

# Install trap BEFORE creating any cleanup-tracked resource (prevents leak
# when a signal lands between mktemp and the trap install).
trap 'cleanup $?' SIGINT SIGTERM EXIT

# Setup error file with mktemp
errfile=$(mktemp -t bcx-error.XXXXXX) || { >&2 echo 'bcx: ✗ Cannot create temp file'; exit 5; }  # ERR_IO
declare -r errfile

# Terminal detection
declare -i is_terminal
[[ -t 1 ]] && is_terminal=1 || is_terminal=0
readonly -- is_terminal

# Check if we have an expression
if (($#)); then
  # Process and evaluate initial expression
  expression=$(process_expression "$@")
  ((is_terminal==0)) || {
    expression=${expression//x/*} # convert x to * if is_terminal
    >&2 echo "> $expression"
  }
  evaluate_expression "$expression" || err=$?
else
  # No expression provided - show help in non-terminal mode
  ((is_terminal)) || { >&2 show_help; exit 2; }  # ERR_USAGE
fi

# Interactive REPL if terminal
if ((is_terminal)); then
  setup_history
  (($#==0)) || history -s "$expression"  # Add initial expression to history if provided
  interactive_loop
  set +o history  # defensive: cleanup() already wrote $HISTFILE on EXIT
fi

exit "$err"
#fin
