#!/bin/bash
# cleanup(), interactive_sigint_handler(), and the trap-only
# fns are invoked via trap argument strings, which shellcheck
# cannot resolve statically — silence its dead-code warnings.
#shellcheck disable=SC2317,SC2329
# bcx - terminal calculator for floating point expressions
set -euo pipefail
shopt -s inherit_errexit

# Lock PATH so external tools (mktemp, rm, cat) resolve to known
# coreutils locations regardless of caller environment (BCS1002).
declare -rx PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Initialization

# Script metadata
declare -r VERSION='1.0.0' # 2025-10-20
# SCRIPT_NAME deliberately uses ${0##*/} (no realpath) so messages reflect
# the invocation name when the script is run via the `?` alias / a symlink.
declare -r SCRIPT_NAME=${0##*/}

# Global variables
declare -- BC ERRFILE EXPRESSION
declare -i ERR=0 IS_TERMINAL=0

# History configuration
# These three names shadow bash's built-in interactive-shell history
# variables on purpose: this script enables `set -o history` and uses
# `history -r`/`history -w` so the bash builtin honours the values
# directly. Renaming would require explicit re-assignment inside
# setup_history(), which is needless indirection.
declare -r HISTFILE="$HOME"/.bcx_history
declare -ri HISTSIZE=1000 HISTFILESIZE=2000

# Functions

# Messaging primitives (BCS0703)
_msg()  { >&2 printf "$SCRIPT_NAME: %s\n" "$@"; }
error() { _msg "✗ $*"; }
die()   { error "${@:2}"; exit "$1"; }

show_help() {
  # Unquoted heredoc expands $SCRIPT_NAME / $VERSION; literal `$` in shell
  # snippets (prompt, command-substitution example) is backslash-escaped.
  cat <<HELP
$SCRIPT_NAME $VERSION - terminal calculator for floating point expressions

This is a wrapper script for bc (see: man bc). Because bc at the terminal sucks.

The same calculation, raw bc vs bcx:

    \$ bc -l <<<'42*72/3.14'
    963.05732484076433121019

    \$ bcx 42*72/3.14
    > 42*72/3.14
    963.05732484076433121019

bcx joins all command-line args, strips spaces, and (in terminal
mode) substitutes 'x' for '*' so the expression needs no quoting
or escaping.

Usage: $SCRIPT_NAME [-h|--help] [-V|--version] [--] [expression...]

  With expression:  evaluate and enter REPL (terminal) or print result (pipe)
  Without args:     enter interactive REPL (terminal) or show help + exit 2 (pipe)

Multiple args are joined and stripped of spaces before evaluation.
Use '--' before expressions that begin with '-' (e.g., '$SCRIPT_NAME -- -3+5').

REPL controls:
  Ctrl-D or empty line  exit (code 0)
  Ctrl-C                exit (code 130)
  ↑/↓                   history navigation
  Ctrl-R                reverse history search

Examples (no quotes needed):
  bcx 23x42                       # 966             (x → *)
  bcx 1024 x 1024 x 1024          # 1073741824      (args joined)
  bcx 22/7                        # 3.14285714...   (mathlib auto-scale)
  bcx 1.05^10                     # 1.62889...      (10-year growth)
  bcx 100x1.05^10                 # 162.889...      (compound interest)

Quote when the expression contains parentheses, semicolons, or
literal whitespace inside a string:
  bcx "sqrt(2)"                   # 1.41421...
  bcx "scale=4; 22/7"             # 3.1428
  bcx "a(1)*4"                    # π via 4·atan(1)

Capture output:
  result=\$(bcx 42x69x72/3.14)

Setup alias in ~/.bashrc:
  alias ?='/usr/local/bin/bcx'

Then:
  ? 23*42         # ✓ no spaces around *
  ? 23 * 42       # ✗ Incorrect on command line!
  ? 23x42         # can use x for * on command line
  ? 23 x 42       # with spaces
HELP
}

cleanup() {
  # EXIT/SIGINT/SIGTERM trap: persist REPL history (terminal mode only),
  # remove the temp error file, then exit with the original status.
  # `trap -` disarms before any blocking I/O so a second signal cannot re-enter.
  # `exit` (not `return`) is required to terminate on SIGTERM rather than resume.
  local -i exit_code=${1:-$?}
  trap - SIGINT SIGTERM EXIT
  ((IS_TERMINAL)) && history -w "$HISTFILE" 2>/dev/null ||:
  rm -f "${ERRFILE:-}"
  exit $exit_code
}

setup_history() {
  set -o history
  # `history -r` is best-effort: a missing file on first run is normal,
  # so swallow stderr and use `||:` to neutralise errexit.
  history -r "$HISTFILE" 2>/dev/null ||:
}

process_expression() {
  # Join all argv into a single expression and strip every space character.
  # Note: the x→* substitution is NOT done here — that's terminal-mode only,
  # applied by the caller after this function returns.
  local -- expr="$*"
  expr=${expr// /}
  printf '%s\n' "$expr"
}

evaluate_expression() {
  # Pipe expression to `bc --mathlib`; capture bc's stderr to $ERRFILE so we
  # can detect parse/runtime errors (bc still exits 0 on syntax errors, hence
  # the file-size probe). Returns 22 (ERR_INVAL) if bc emitted any diagnostic,
  # else 0.
  local -- expr=$1
  local -i exit_code=0

  "$BC" --mathlib <<<"$expr" 2>"$ERRFILE"

  if [[ -s $ERRFILE ]]; then
    error "Invalid expression ${expr@Q}"
    >&2 cat "$ERRFILE"
    exit_code=22  # ERR_INVAL (BCS0602)
  fi

  return $exit_code
}

interactive_sigint_handler() {
  # Handle Ctrl-C during interactive REPL.
  # EXIT trap handles cleanup; just exit with signal code.
  >&2 echo
  exit 130
}

interactive_loop() {
  # REPL with readline editing (`read -e`) and persistent history.
  # Override SIGINT so Ctrl-C exits with code 130 instead of being silently
  # caught by the global cleanup trap; restored to cleanup on exit.
  trap 'interactive_sigint_handler' SIGINT

  local -- expr
  while :; do
    read -e -r -p '> ' expr || break  # Ctrl-D / EOF
    [[ -n $expr ]] || break            # blank line
    history -s "$expr"
    evaluate_expression "$expr" ||:    # bc errors don't break the loop
  done

  trap 'cleanup $?' SIGINT
}

# Execution

# Argument parsing (BCS0801).
# Stops on first non-option; everything left is the expression.
while (($#)); do case $1 in
  -h|--help)    show_help; exit 0 ;;
  -V|--version) printf '%s %s\n' "$SCRIPT_NAME" "$VERSION"; exit 0 ;;
  --)           shift; break ;;
  -*)           die 22 "Invalid option ${1@Q}" ;;  # ERR_INVAL
  *)            break ;;
esac; shift; done

# Locate bc command
BC=$(command -v bc) || die 18 "'bc' not found"  # ERR_NODEP
declare -r BC

# Install trap BEFORE creating any cleanup-tracked resource (prevents leak
# when a signal lands between mktemp and the trap install).
trap 'cleanup $?' SIGINT SIGTERM EXIT

# Setup error file with mktemp
ERRFILE=$(mktemp -t bcx-error.XXXXXX) || die 5 'Cannot create temp file'  # ERR_IO
declare -r ERRFILE

# Terminal detection (BCS0105: both stdout AND stderr must be a TTY)
[[ -t 1 && -t 2 ]] && IS_TERMINAL=1 || IS_TERMINAL=0
readonly IS_TERMINAL

# Check if we have an expression
if (($#)); then
  EXPRESSION=$(process_expression "$@")
  ((IS_TERMINAL)) && {
    EXPRESSION=${EXPRESSION//x/*}    # convert x to * in terminal mode
    >&2 echo "> $EXPRESSION"
  } ||:                              # BCS0606: defensive guard
  evaluate_expression "$EXPRESSION" || ERR=$?
else
  # No expression in pipe mode: show help and exit usage error.
  ((IS_TERMINAL)) || { >&2 show_help; exit 2; }  # ERR_USAGE
fi

# Interactive REPL if terminal
if ((IS_TERMINAL)); then
  setup_history
  (($#)) && history -s "$EXPRESSION" ||:   # seed REPL history with initial expression
  interactive_loop
  set +o history  # defensive: cleanup() already wrote $HISTFILE on EXIT
fi

exit $ERR
#fin
